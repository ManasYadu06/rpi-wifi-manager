[Unit]
Description=RPi WiFi Captive Portal (Web UI)
After=network.target rpi-wifi-manager.service
Wants=rpi-wifi-manager.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 -u /usr/local/bin/wifi-portal.py
Restart=always
RestartSec=5

EnvironmentFile=-/etc/rpi-wifi-manager/config

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rpi-wifi-portal

[Install]
WantedBy=multi-user.target
